@model DashboardStatistics
@{
    ViewData["Title"] = "Админ панел";
}

<h1 class="h3 fw-bold mb-4">Админ панел</h1>

<div class="row g-3">
    <div class="col-6 col-lg">
        <div class="stat-card p-3 rounded-4">
            <div class="text-muted small">Приюти</div>
            <div class="stat-value">@Model.Shelters</div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="stat-card p-3 rounded-4">
            <div class="text-muted small">Животни за осиновяване</div>
            <div class="stat-value">@Model.AvailableAnimals</div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="stat-card p-3 rounded-4">
            <div class="text-muted small">Осиновени</div>
            <div class="stat-value">@Model.AdoptedAnimals</div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="stat-card p-3 rounded-4">
            <div class="text-muted small">Чакащи заявки</div>
            <div class="stat-value">@Model.PendingAdoptionRequests</div>
        </div>
    </div>
    <div class="col-12 col-lg">
        <div class="stat-card p-3 rounded-4">
            <div class="text-muted small">Отворени сигнали</div>
            <div class="stat-value">@Model.OpenStrayReports</div>
        </div>
    </div>
</div>

<p class="text-muted mt-4">
    Управлението на приюти, потребители, видове, породи и сигнали се добавя в Етап 3.
</p>
